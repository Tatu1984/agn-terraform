# Managed by Ansible (infra repo) — edits here are overwritten on the next run.
DOMAIN={{ domain }}
APP_TAG={{ app_tag }}

# no-verify: TLS on, CA check off (RDS CA is not in Node's trust store)
DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:5432/{{ db_name }}?sslmode=no-verify
DIRECT_URL=postgresql://{{ db_user }}:{{ db_password }}@{{ db_host }}:5432/{{ db_name }}?sslmode=no-verify

BETTER_AUTH_SECRET={{ better_auth_secret }}
BETTER_AUTH_URL={{ app_url }}
NEXT_PUBLIC_AUTH_BASE_URL={{ app_url }}
NEXT_PUBLIC_API_URL=

# S3 via the EC2 instance role: endpoint + keys stay empty.
AWS_REGION={{ aws_region }}
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME={{ media_bucket }}
R2_PUBLIC_URL={{ media_base_url }}

PUSHER_APP_ID={{ pusher_app_id }}
PUSHER_KEY={{ pusher_key }}
PUSHER_SECRET={{ pusher_secret }}
PUSHER_CLUSTER={{ pusher_cluster }}
NEXT_PUBLIC_PUSHER_KEY={{ pusher_key }}
NEXT_PUBLIC_PUSHER_CLUSTER={{ pusher_cluster }}

PAYPAL_CLIENT_ID={{ paypal_client_id }}
PAYPAL_CLIENT_SECRET={{ paypal_client_secret }}
PAYPAL_MODE={{ paypal_mode }}
PAYPAL_WEBHOOK_ID={{ paypal_webhook_id }}

WINDY_POINT_KEY={{ windy_point_key }}
NEXT_PUBLIC_WINDY_MAP_KEY={{ windy_map_key }}

CRON_SECRET={{ cron_secret }}
